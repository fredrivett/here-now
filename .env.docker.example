# Docker Compose Environment Variables
# Copy this file to .env and update the values

# Required: Comma-separated list of domains allowed to use your here/now instance
# Example: localhost,example.com,blog.example.com
ALLOWED_DOMAINS=localhost

# Optional: Override the API base URL used by the widget
# Leave empty to auto-detect from request (recommended)
# Only set this if you're behind a reverse proxy with a different public URL
# API_BASE_URL=https://analytics.yourdomain.com
